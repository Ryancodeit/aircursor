# ============================================================
# AirCursor Environment Variables Configuration
# ============================================================

# PORT (Server)
# Required by Render/Node host. In Render, this is set automatically to 10000 or similar.
# Default for local development: 3001
PORT=3001

# VITE_APP_URL (Frontend Client)
# Optional: Public HTTP/HTTPS URL of the deployed application used for QR code generation.
# If omitted, AirCursor dynamically uses window.location.origin.
# Example for Render: https://aircursor.onrender.com
VITE_APP_URL=http://localhost:3000

# VITE_WS_URL (WebSocket Client)
# Optional: Target WebSocket URL (ws:// or wss://) for mobile controller & target connections.
# If omitted, AirCursor dynamically uses wss://<window.location.host> in production.
# Example for Render: wss://aircursor.onrender.com
VITE_WS_URL=ws://localhost:3001
