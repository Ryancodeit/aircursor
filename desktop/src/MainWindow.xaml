<Window x:Class="AirCursorDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirCursor Desktop — Windows Mouse Controller"
        Height="520" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#0b0f19" Foreground="#ffffff">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock Text="AIRCURSOR" FontSize="22" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center"/>
            <TextBlock Text=" DESKTOP" FontSize="22" FontWeight="Light" Foreground="#ffffff" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Status Card -->
        <Border Grid.Row="1" Background="#161e2e" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#2a364f" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="Initializing AirCursor Desktop..." FontSize="14" FontWeight="SemiBold" Foreground="#a0aec0" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtPairCode" Text="------" FontSize="36" FontWeight="ExtraBold" Foreground="#38bdf8" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                <TextBlock Text="Scan QR code or enter code on mobile phone" FontSize="11" Foreground="#718096" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Control Actions Panel -->
        <Border Grid.Row="2" Background="#161e2e" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#2a364f" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="MOUSE SENSITIVITY" FontSize="11" FontWeight="Bold" Foreground="#a0aec0" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SliderSensitivity" Minimum="0.2" Maximum="3.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="SliderSensitivity_ValueChanged"/>
                    <TextBlock x:Name="TxtSensitivityVal" Grid.Column="1" Text="1.0x" Foreground="#38bdf8" FontWeight="Bold" Margin="10,0,0,0"/>
                </Grid>

                <TextBlock Text="SAFETY CONTROLS" FontSize="11" FontWeight="Bold" Foreground="#a0aec0" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnCalibrate" Grid.Column="0" Content="🎯 Calibrate" Height="38" Background="#0284c7" Foreground="White" FontWeight="Bold" Click="BtnCalibrate_Click"/>
                    <Button x:Name="BtnEmergencyStop" Grid.Column="2" Content="🛑 Emergency Stop" Height="38" Background="#dc2626" Foreground="White" FontWeight="Bold" Click="BtnEmergencyStop_Click"/>
                </Grid>

                <Button x:Name="BtnResume" Content="▶ Resume Mouse Control" Height="34" Background="#16a34a" Foreground="White" FontWeight="Bold" Click="BtnResume_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Server Settings -->
        <Border Grid.Row="3" Background="#161e2e" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SERVER CONNECTION URL" FontSize="10" Foreground="#718096" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtServerUrl" Text="wss://aircursor.onrender.com" Background="#0b0f19" Foreground="#ffffff" BorderBrush="#2a364f" Padding="6,4" FontSize="11"/>
                    <Button x:Name="BtnReconnect" Grid.Column="1" Content="Reconnect" Margin="8,0,0,0" Padding="10,4" Background="#334155" Foreground="White" Click="BtnReconnect_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="4" Text="AirCursor Desktop • Controls real Windows cursor safely via WSS" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
    </Grid>
</Window>
